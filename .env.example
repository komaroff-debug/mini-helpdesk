# SQLite by default - no extra setup needed.
# For Postgres use: postgresql+psycopg2://user:password@localhost:5432/helpdesk
DATABASE_URL=sqlite:///./data/helpdesk.db

# Generate your own secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_YOUR_OWN_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
